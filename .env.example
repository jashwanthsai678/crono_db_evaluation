# Copy this file to .env and fill in real values. .env is gitignored — never commit secrets.

# --- CognoDB Cloud (managed, free c0 tier) ---
# From https://console.cognodb.com after creating a free instance.
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# --- Neo4j (self-hosted, Docker, resource-capped) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Memgraph (self-hosted, Docker, resource-capped) ---
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# --- ArangoDB (self-hosted, Docker, resource-capped) ---
ARANGO_URL=http://localhost:8529
ARANGO_USER=root
ARANGO_PASSWORD=
ARANGO_DB=benchmark

# --- Dgraph (self-hosted, Docker, resource-capped) ---
DGRAPH_GRPC=localhost:9080
